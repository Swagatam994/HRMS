# Dependencies
node_modules/
**/node_modules/

# Build outputs
/dist/
**/dist/
/build/
**/build/

# Environment files — never commit secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
.env.local
.env.development
.env.production
.env.test
Backend/.env
Backend/.env.*
!Backend/.env.example
Frontend/.env
Frontend/.env.*
!Frontend/.env.example

# Uploaded files (user uploads)
Backend/uploads/*
!Backend/uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local uploads / temp data
Backend/uploads/
Backend/tmp/
Backend/.cache/
Frontend/.vite/
logs/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

